{
  "name": "@infinite-world/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prepare:whisper": "node scripts/prepare-whisper-model.mjs",
    "build": "pnpm prepare:whisper && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsc --noEmit -p tsconfig.test.json && tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.63",
    "@ai-sdk/openai-compatible": "3.0.43",
    "@fal-ai/client": "^1.9.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.2.0",
    "@infinite-world/api-contract": "workspace:*",
    "ai": "7.0.91",
    "dotenv": "^17.4.2",
    "fastify": "^5.4.0",
    "tmi.js": "^1.8.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
